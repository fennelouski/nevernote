    "You just took a screenshot. Share the note text, or create a clean image of your text only.": {
      "comment": "You just took a screenshot. Share the note text, or create a clean image of your text only.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You just took a screenshot. Share the note text, or create a clean image of your text only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabas de tomar una captura de pantalla. Comparta el texto de la nota o cree una imagen limpia solo de su texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous venez de prendre une capture d'écran. Partagez le texte de la note ou créez une image propre de votre texte uniquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast gerade einen Screenshot gemacht. Teilen Sie den Notiztext oder erstellen Sie nur ein sauberes Bild Ihres Textes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai appena fatto uno screenshot. Condividi il testo della nota o crea un'immagine pulita solo del tuo testo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você acabou de tirar uma captura de tela. Compartilhe o texto da nota ou crie uma imagem limpa apenas do seu texto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットを撮りました。メモのテキストを共有するか、テキストのみのクリーンな画像を作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 스크린샷을 찍으셨습니다. 메모 텍스트를 공유하거나 텍스트만 포함된 깔끔한 이미지를 만드세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你刚刚截图了。共享注释文本，或仅创建文本的干净图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你剛剛截圖了。共享註釋文本，或僅創建文本的乾淨圖像。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد التقطت للتو لقطة شاشة. قم بمشاركة نص الملاحظة، أو قم بإنشاء صورة نظيفة للنص الخاص بك فقط."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы только что сделали скриншот. Поделитесь текстом заметки или создайте чистое изображение только вашего текста."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने अभी स्क्रीनशॉट लिया है. नोट टेक्स्ट साझा करें, या केवल अपने टेक्स्ट की एक साफ़ छवि बनाएं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt zojuist een screenshot gemaakt. Deel de notitietekst of maak alleen een schone afbeelding van uw tekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Właśnie zrobiłeś zrzut ekranu. Udostępnij tekst notatki lub utwórz czysty obraz samego tekstu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tog precis en skärmdump. Dela anteckningstexten eller skapa en ren bild av endast din text."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Az önce bir ekran görüntüsü aldınız. Not metnini paylaşın veya yalnızca metninizin temiz bir görüntüsünü oluşturun."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเพิ่งจับภาพหน้าจอ แบ่งปันข้อความบันทึกหรือสร้างภาพข้อความของคุณที่สะอาดตาเท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn vừa chụp ảnh màn hình. Chia sẻ văn bản ghi chú hoặc chỉ tạo một hình ảnh rõ ràng cho văn bản của bạn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda baru saja mengambil tangkapan layar. Bagikan teks catatan, atau buat gambar bersih dari teks Anda saja."
          }
        }
      }
    },
