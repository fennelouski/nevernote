    "NeverNote will read any text in the image and add it to your note.": {
      "comment": "NeverNote will read any text in the image and add it to your note.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote will read any text in the image and add it to your note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote leerá cualquier texto de la imagen y lo agregará a su nota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote lira n'importe quel texte dans l'image et l'ajoutera à votre note."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote liest jeden Text im Bild und fügt ihn Ihrer Notiz hinzu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote leggerà qualsiasi testo nell'immagine e lo aggiungerà alla tua nota."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote irá ler qualquer texto da imagem e adicioná-lo à sua nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote は画像内のテキストを読み取り、メモに追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote는 이미지의 텍스트를 읽고 이를 메모에 추가합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote 将读取图像中的任何文本并将其添加到您的笔记中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote 將讀取圖像中的任何文字並將其添加到您的筆記中。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سوف يقوم NeverNote بقراءة أي نص في الصورة وإضافته إلى ملاحظتك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote прочитает любой текст на изображении и добавит его в заметку."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेवरनोट छवि में मौजूद किसी भी पाठ को पढ़ेगा और उसे आपके नोट में जोड़ देगा।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote leest elke tekst in de afbeelding en voegt deze toe aan uw notitie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote odczyta dowolny tekst z obrazu i doda go do Twojej notatki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote kommer att läsa all text i bilden och lägga till den i din anteckning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote, görseldeki herhangi bir metni okuyacak ve notunuza ekleyecektir."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote จะอ่านข้อความใดๆ ในภาพและเพิ่มลงในบันทึกย่อของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote sẽ đọc bất kỳ văn bản nào trong hình ảnh và thêm nó vào ghi chú của bạn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote akan membaca teks apa pun di gambar dan menambahkannya ke catatan Anda."
          }
        }
      }
    },
