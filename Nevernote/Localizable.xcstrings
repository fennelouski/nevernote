        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عکس بگیرید یا یکی از کتابخانه خود را انتخاب کنید. NeverNote هر متنی را در تصویر می خواند و به یادداشت شما اضافه می کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
