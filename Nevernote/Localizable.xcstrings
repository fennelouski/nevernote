    "screenshot.demo.1": {
      "comment": "screenshot.demo.1",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfect for catching a quick number during a call."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfecto para capturar un número rápido durante una llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parfait pour attraper un numéro rapide lors d’un appel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfekt, um während eines Anrufs schnell eine Nummer zu erwischen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfetto per prendere un numero veloce durante una chiamata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfeito para pegar um número rápido durante uma chamada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話中に簡単に番号をキャッチするのに最適です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화 중에 빠르게 전화번호를 확인하는 데 적합합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非常适合在通话过程中快速接听号码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "非常適合在通話過程中快速接聽號碼。"
          }
