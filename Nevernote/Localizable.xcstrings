          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਚਿੱਤਰ ਵਿੱਚ ਸਿਰਫ਼ ਤੁਹਾਡਾ ਟੈਕਸਟ ਅਤੇ ਬੈਕਗ੍ਰਾਊਂਡ ਹੋਵੇਗਾ — ਕੋਈ ਬਟਨ ਜਾਂ ਫ੍ਰੇਮ ਨਹੀਂ।"
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "රූපයේ අඩංගු වන්නේ ඔබේ පෙළ සහ පසුබිම පමණි - බොත්තම් හෝ රාමු නොමැත."
          }
        },
        "sq": {
