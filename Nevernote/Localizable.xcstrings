    "You just took a screenshot. Share the note text, or create a clean image of your text only.": {
      "comment": "You just took a screenshot. Share the note text, or create a clean image of your text only.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد التقطت للتو لقطة شاشة. قم بمشاركة نص الملاحظة، أو قم بإنشاء صورة نظيفة للنص الخاص بك فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি শুধু একটি স্ক্রিনশট নিয়েছেন। নোট টেক্সট শেয়ার করুন, অথবা শুধুমাত্র আপনার টেক্সট একটি পরিষ্কার ইমেজ তৈরি করুন."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabes de fer una captura de pantalla. Comparteix el text de la nota o crea una imatge neta només del teu text."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Právě jste udělali snímek obrazovky. Sdílejte text poznámky nebo vytvořte čistý obrázek pouze svého textu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har lige taget et skærmbillede. Del noteteksten, eller lav kun et rent billede af din tekst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast gerade einen Screenshot gemacht. Teilen Sie den Notiztext oder erstellen Sie nur ein sauberes Bild Ihres Textes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόλις τραβήξατε ένα στιγμιότυπο οθόνης. Μοιραστείτε το κείμενο της σημείωσης ή δημιουργήστε μια καθαρή εικόνα μόνο του κειμένου σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You just took a screenshot. Share the note text, or create a clean image of your text only."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "You just took a screenshot. Share the note text, or create a clean image of your text only."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "You just took a screenshot. Share the note text, or create a clean image of your text only."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You just took a screenshot. Share the note text, or create a clean image of your text only."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "You just took a screenshot. Share the note text, or create a clean image of your text only."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You just took a screenshot. Share the note text, or create a clean image of your text only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabas de tomar una captura de pantalla. Comparta el texto de la nota o cree una imagen limpia solo de su texto."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabas de tomar una captura de pantalla. Comparta el texto de la nota o cree una imagen limpia solo de su texto."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabas de tomar una captura de pantalla. Comparta el texto de la nota o cree una imagen limpia solo de su texto."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabas de tomar una captura de pantalla. Comparta el texto de la nota o cree una imagen limpia solo de su texto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Otit juuri kuvakaappauksen. Jaa muistiinpanokeksti tai luo puhdas kuva vain tekstistäsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous venez de prendre une capture d'écran. Partagez le texte de la note ou créez une image propre de votre texte uniquement."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous venez de prendre une capture d'écran. Partagez le texte de la note ou créez une image propre de votre texte uniquement."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે હમણાં જ સ્ક્રીનશોટ લીધો. નોંધનો ટેક્સ્ટ શેર કરો અથવા ફક્ત તમારા ટેક્સ્ટની સ્વચ્છ છબી બનાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרגע צילמת מסך. שתף את טקסט ההערה, או צור תמונה נקייה של הטקסט שלך בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने अभी स्क्रीनशॉट लिया है. नोट टेक्स्ट साझा करें, या केवल अपने टेक्स्ट की एक साफ़ छवि बनाएं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upravo ste napravili snimku zaslona. Podijelite tekst bilješke ili stvorite čistu sliku samo svog teksta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Most csináltál egy képernyőképet. Ossza meg a jegyzet szövegét, vagy hozzon létre tiszta képet csak a szövegből."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda baru saja mengambil tangkapan layar. Bagikan teks catatan, atau buat gambar bersih dari teks Anda saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai appena fatto uno screenshot. Condividi il testo della nota o crea un'immagine pulita solo del tuo testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットを撮りました。メモのテキストを共有するか、テキストのみのクリーンな画像を作成します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಈಗಷ್ಟೇ ಸ್ಕ್ರೀನ್‌ಶಾಟ್ ತೆಗೆದುಕೊಂಡಿದ್ದೀರಿ. ಟಿಪ್ಪಣಿ ಪಠ್ಯವನ್ನು ಹಂಚಿಕೊಳ್ಳಿ ಅಥವಾ ನಿಮ್ಮ ಪಠ್ಯದ ಶುದ್ಧ ಚಿತ್ರವನ್ನು ಮಾತ್ರ ರಚಿಸಿ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 스크린샷을 찍으셨습니다. 메모 텍스트를 공유하거나 텍스트만 포함된 깔끔한 이미지를 만드세요."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഒരു സ്ക്രീൻഷോട്ട് എടുത്തു. കുറിപ്പ് ടെക്‌സ്‌റ്റ് പങ്കിടുക, അല്ലെങ്കിൽ നിങ്ങളുടെ ടെക്‌സ്‌റ്റിൻ്റെ മാത്രം ക്ലീൻ ഇമേജ് സൃഷ്‌ടിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही फक्त स्क्रीनशॉट घेतला. नोटचा मजकूर शेअर करा किंवा फक्त तुमच्या मजकुराची स्वच्छ प्रतिमा तयार करा."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda baru sahaja mengambil tangkapan skrin. Kongsi teks nota atau buat imej bersih teks anda sahaja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tok nettopp et skjermbilde. Del notatteksten, eller lag bare et rent bilde av teksten din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt zojuist een screenshot gemaakt. Deel de notitietekst of maak alleen een schone afbeelding van uw tekst."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ କେବଳ ଏକ ସ୍କ୍ରିନସଟ୍ ନେଇଛନ୍ତି | ନୋଟ୍ ପାଠ୍ୟ ଅଂଶୀଦାର କରନ୍ତୁ, କିମ୍ବା କେବଳ ଆପଣଙ୍କ ପାଠ୍ୟର ଏକ ସ୍ୱଚ୍ଛ ପ୍ରତିଛବି ସୃଷ୍ଟି କରନ୍ତୁ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਹੁਣੇ ਇੱਕ ਸਕ੍ਰੀਨਸ਼ੌਟ ਲਿਆ ਹੈ। ਨੋਟ ਟੈਕਸਟ ਨੂੰ ਸਾਂਝਾ ਕਰੋ, ਜਾਂ ਸਿਰਫ ਆਪਣੇ ਟੈਕਸਟ ਦੀ ਇੱਕ ਸਾਫ਼ ਚਿੱਤਰ ਬਣਾਓ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Właśnie zrobiłeś zrzut ekranu. Udostępnij tekst notatki lub utwórz czysty obraz samego tekstu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você acabou de tirar uma captura de tela. Compartilhe o texto da nota ou crie uma imagem limpa apenas do seu texto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Você acabou de tirar uma captura de tela. Compartilhe o texto da nota ou crie uma imagem limpa apenas do seu texto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocmai ai făcut o captură de ecran. Partajați textul notei sau creați o imagine curată numai a textului dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы только что сделали скриншот. Поделитесь текстом заметки или создайте чистое изображение только вашего текста."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Práve ste urobili snímku obrazovky. Zdieľajte text poznámky alebo vytvorte čistý obrázok iba svojho textu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pravkar ste naredili posnetek zaslona. Delite besedilo opombe ali ustvarite čisto sliko samo svojega besedila."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tog precis en skärmdump. Dela anteckningstexten eller skapa en ren bild av endast din text."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இப்போதுதான் ஸ்கிரீன்ஷாட் எடுத்தீர்கள். குறிப்பு உரையைப் பகிரவும் அல்லது உங்கள் உரையின் சுத்தமான படத்தை மட்டும் உருவாக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఇప్పుడే స్క్రీన్ షాట్ తీశారు. గమనిక వచనాన్ని భాగస్వామ్యం చేయండి లేదా మీ వచనం యొక్క క్లీన్ ఇమేజ్‌ను మాత్రమే సృష్టించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเพิ่งจับภาพหน้าจอ แบ่งปันข้อความบันทึกหรือสร้างภาพข้อความของคุณที่สะอาดตาเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Az önce bir ekran görüntüsü aldınız. Not metnini paylaşın veya yalnızca metninizin temiz bir görüntüsünü oluşturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви щойно зробили скріншот. Поділіться текстом нотатки або створіть лише чисте зображення свого тексту."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے ابھی اسکرین شاٹ لیا ہے۔ نوٹ کے متن کا اشتراک کریں، یا صرف اپنے متن کی ایک صاف تصویر بنائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn vừa chụp ảnh màn hình. Chia sẻ văn bản ghi chú hoặc chỉ tạo một hình ảnh rõ ràng cho văn bản của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你刚刚截图了。共享注释文本，或仅创建文本的干净图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你剛剛截圖了。共享註釋文本，或僅創建文本的乾淨圖像。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你剛剛截圖了。共享註釋文本，或僅創建文本的乾淨圖像。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jy het pas 'n skermkiekie geneem. Deel die notateks, of skep 'n skoon beeld van slegs jou teks."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Току-що направихте екранна снимка. Споделете текста на бележката или създайте чисто изображение само от вашия текст."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegite just ekraanipildi. Jagage märkuse teksti või looge puhas pilt ainult oma tekstiga."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantaila argazkia atera berri duzu. Partekatu oharraren testua, edo sortu zure testuaren irudi garbia soilik."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شما تازه یک اسکرین‌شات گرفتید. متن یادداشت را به اشتراک بگذارید، یا یک تصویر تمیز فقط از متن خود بسازید."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghlac tú grianghraf scáileáin díreach anois. Comhroinn téacs an nóta, nó cruthaigh íomhá ghlan de do théacs amháin."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabas de facer unha captura de pantalla. Comparte o texto da nota ou crea unha imaxe limpa só co teu texto."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Duk nore ekranaketsek. Kesavek nshumi tekste kam skizbeq sufta patker miain dzer tekstov."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú tókst skjáskot. Deildu texta athugasemdarinnar eða búðu til hreina mynd af texta þínum eingöngu."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ახლახან გადაიღეთ ეკრანის სურათი. გააზიარეთ ჩანაწერის ტექსტი ან შექმენით სუფთა სურათი მხოლოდ თქვენი ტექსტით."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ką tik padarėte ekrano nuotrauką. Bendrinkite pastabos tekstą arba sukurkite švarų savo teksto vaizdą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūs tikko uzņēmāt ekrānuzņēmumu. Kopīgojiet piezīmes tekstu vai izveidojiet tīru tikai sava teksta attēlu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Штотуку направивте скриншот. Споделете го текстот на белешката или создадете чиста слика само од вашиот текст."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Sapo keni bërë një pamje ekrani. Ndani tekstin e shënimit ose krijoni një imazh të pastër vetëm të tekstit tuaj."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Управо сте направили снимак екрана. Поделите текст белешке или направите чисту слику само са вашим текстом."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Umepiga picha ya skrini. Shiriki maandishi ya kidokezo, au unda picha safi ya maandishi yako tu."
          }
        }
      }
    },
