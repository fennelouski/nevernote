    "The image will contain only your text and background — no buttons or frames.": {
      "comment": "The image will contain only your text and background — no buttons or frames.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستحتوي الصورة على النص والخلفية فقط، بدون أزرار أو إطارات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবিতে শুধুমাত্র আপনার পাঠ্য এবং পটভূমি থাকবে - কোন বোতাম বা ফ্রেম নেই।"
