    "The image will contain only your text and background — no buttons or frames.": {
      "comment": "The image will contain only your text and background — no buttons or frames.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image will contain only your text and background — no buttons or frames."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen contendrá solo su texto y fondo, sin botones ni marcos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'image contiendra uniquement votre texte et votre arrière-plan, sans boutons ni cadres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild enthält nur Ihren Text und Hintergrund – keine Schaltflächen oder Rahmen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'immagine conterrà solo il testo e lo sfondo, senza pulsanti o cornici."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem conterá apenas o texto e o plano de fundo – sem botões ou molduras."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像にはテキストと背景のみが含まれ、ボタンやフレームは含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지에는 버튼이나 프레임이 없이 텍스트와 배경만 포함됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该图像将仅包含您的文本和背景 - 没有按钮或框架。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該圖像將僅包含您的文字和背景 - 沒有按鈕或框架。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستحتوي الصورة على النص والخلفية فقط، بدون أزرار أو إطارات."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображение будет содержать только ваш текст и фон — никаких кнопок и рамок."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छवि में केवल आपका टेक्स्ट और पृष्ठभूमि होगी - कोई बटन या फ़्रेम नहीं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De afbeelding bevat alleen uw tekst en achtergrond, geen knoppen of kaders."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obraz będzie zawierał tylko tekst i tło — bez przycisków i ramek."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilden kommer bara att innehålla din text och bakgrund – inga knappar eller ramar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resim yalnızca metninizi ve arka planınızı içerecektir; düğme veya çerçeve olmayacaktır."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพจะมีเฉพาะข้อความและพื้นหลังของคุณเท่านั้น ไม่มีปุ่มหรือกรอบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình ảnh sẽ chỉ chứa văn bản và nền của bạn - không có nút hoặc khung."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar hanya akan berisi teks dan latar belakang Anda — tanpa tombol atau bingkai."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зображення міститиме лише ваш текст і фон — без кнопок і рамок."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה תכיל רק את הטקסט והרקע שלך - ללא כפתורים או מסגרות."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ছবিতে শুধুমাত্র আপনার পাঠ্য এবং পটভূমি থাকবে - কোন বোতাম বা ফ্রেম নেই।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "படத்தில் உங்கள் உரை மற்றும் பின்னணி மட்டுமே இருக்கும் - பொத்தான்கள் அல்லது பிரேம்கள் இல்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చిత్రం మీ వచనం మరియు నేపథ్యాన్ని మాత్రమే కలిగి ఉంటుంది - బటన్లు లేదా ఫ్రేమ్‌లు లేవు."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रतिमेमध्ये फक्त तुमचा मजकूर आणि पार्श्वभूमी असेल — कोणतेही बटण किंवा फ्रेम नाहीत."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر میں صرف آپ کا متن اور پس منظر ہوگا - کوئی بٹن یا فریم نہیں۔"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billedet vil kun indeholde din tekst og baggrund - ingen knapper eller rammer."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildet vil kun inneholde tekst og bakgrunn – ingen knapper eller rammer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuva sisältää vain tekstin ja taustan – ei painikkeita tai kehyksiä."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrázek bude obsahovat pouze váš text a pozadí – žádná tlačítka ani rámečky."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrázok bude obsahovať iba váš text a pozadie – žiadne tlačidlá ani rámy."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kép csak a szöveget és a hátteret tartalmazza – gombok vagy keretek nélkül."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaginea va conține doar textul și fundalul dvs. - fără butoane sau cadre."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slika će sadržavati samo vaš tekst i pozadinu — bez gumba ili okvira."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slika bo vsebovala samo vaše besedilo in ozadje – brez gumbov ali okvirjev."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εικόνα θα περιέχει μόνο το κείμενο και το φόντο σας — χωρίς κουμπιά ή πλαίσια."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La imatge només contindrà el vostre text i fons, sense botons ni marcs."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imej akan mengandungi hanya teks dan latar belakang anda — tiada butang atau bingkai."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem conterá apenas o texto e o plano de fundo – sem botões ou molduras."
          }
        }
      }
    },
