    "Take a photo or choose one from your library. NeverNote will read any text in the image and add it to your note.": {
      "comment": "Take a photo or choose one from your library. NeverNote will read any text in the image and add it to your note.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقط صورة أو اختر واحدة من مكتبتك. سوف يقوم NeverNote بقراءة أي نص في الصورة وإضافته إلى ملاحظتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি ফটো তুলুন বা আপনার লাইব্রেরি থেকে একটি চয়ন করুন৷ NeverNote ইমেজের কোনো লেখা পড়বে এবং আপনার নোটে যোগ করবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes una foto o tria una de la teva biblioteca. NeverNote llegirà qualsevol text de la imatge i l'afegirà a la teva nota."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pořiďte fotku nebo si vyberte jednu ze své knihovny. NeverNote přečte jakýkoli text v obrázku a přidá jej do vaší poznámky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag et billede, eller vælg et fra dit bibliotek. NeverNote vil læse enhver tekst i billedet og tilføje den til din note."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Machen Sie ein Foto oder wählen Sie eines aus Ihrer Bibliothek aus. NeverNote liest jeden Text im Bild und fügt ihn Ihrer Notiz hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τραβήξτε μια φωτογραφία ή επιλέξτε μία από τη βιβλιοθήκη σας. Το NeverNote θα διαβάσει οποιοδήποτε κείμενο στην εικόνα και θα το προσθέσει στη σημείωσή σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo or choose one from your library. NeverNote will read any text in the image and add it to your note."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo or choose one from your library. NeverNote will read any text in the image and add it to your note."
          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo or choose one from your library. NeverNote will read any text in the image and add it to your note."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo or choose one from your library. NeverNote will read any text in the image and add it to your note."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo or choose one from your library. NeverNote will read any text in the image and add it to your note."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo or choose one from your library. NeverNote will read any text in the image and add it to your note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma una foto o elige una de tu biblioteca. NeverNote leerá cualquier texto de la imagen y lo agregará a su nota."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma una foto o elige una de tu biblioteca. NeverNote leerá cualquier texto de la imagen y lo agregará a su nota."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma una foto o elige una de tu biblioteca. NeverNote leerá cualquier texto de la imagen y lo agregará a su nota."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma una foto o elige una de tu biblioteca. NeverNote leerá cualquier texto de la imagen y lo agregará a su nota."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota valokuva tai valitse yksi kirjastostasi. NeverNote lukee minkä tahansa kuvan tekstin ja lisää sen muistiinpanoosi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez une photo ou choisissez-en une dans votre bibliothèque. NeverNote lira n'importe quel texte dans l'image et l'ajoutera à votre note."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez une photo ou choisissez-en une dans votre bibliothèque. NeverNote lira n'importe quel texte dans l'image et l'ajoutera à votre note."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોટો લો અથવા તમારી લાઇબ્રેરીમાંથી એક પસંદ કરો. NeverNote ઈમેજમાં કોઈપણ ટેક્સ્ટ વાંચશે અને તેને તમારી નોંધમાં ઉમેરશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צלם תמונה או בחר תמונה מהספרייה שלך. NeverNote יקרא כל טקסט בתמונה ויוסיף אותו להערה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक फ़ोटो लें या अपनी लाइब्रेरी से कोई एक चुनें। नेवरनोट छवि में मौजूद किसी भी पाठ को पढ़ेगा और उसे आपके नोट में जोड़ देगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snimite fotografiju ili odaberite jednu iz svoje biblioteke. NeverNote će pročitati bilo koji tekst na slici i dodati ga vašoj bilješci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Készítsen fényképet, vagy válasszon egyet a könyvtárából. A NeverNote elolvassa a kép bármely szövegét, és hozzáadja a jegyzethez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil foto atau pilih salah satu dari perpustakaan Anda. NeverNote akan membaca teks apa pun di gambar dan menambahkannya ke catatan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta una foto o scegline una dalla tua libreria. NeverNote leggerà qualsiasi testo nell'immagine e lo aggiungerà alla tua nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を撮るか、ライブラリから写真を選択します。 NeverNote は画像内のテキストを読み取り、メモに追加します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋಟೋ ತೆಗೆದುಕೊಳ್ಳಿ ಅಥವಾ ನಿಮ್ಮ ಲೈಬ್ರರಿಯಿಂದ ಒಂದನ್ನು ಆಯ್ಕೆಮಾಡಿ. NeverNote ಚಿತ್ರದಲ್ಲಿನ ಯಾವುದೇ ಪಠ್ಯವನ್ನು ಓದುತ್ತದೆ ಮತ್ತು ಅದನ್ನು ನಿಮ್ಮ ಟಿಪ್ಪಣಿಗೆ ಸೇರಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 찍거나 라이브러리에서 사진을 선택하세요. NeverNote는 이미지의 텍스트를 읽고 이를 메모에 추가합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ഫോട്ടോ എടുക്കുക അല്ലെങ്കിൽ നിങ്ങളുടെ ലൈബ്രറിയിൽ നിന്ന് ഒന്ന് തിരഞ്ഞെടുക്കുക. NeverNote ചിത്രത്തിലെ ഏതെങ്കിലും വാചകം വായിച്ച് നിങ്ങളുടെ കുറിപ്പിലേക്ക് ചേർക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एक फोटो घ्या किंवा तुमच्या लायब्ररीमधून एक निवडा. NeverNote इमेजमधील कोणताही मजकूर वाचेल आणि तो तुमच्या नोटमध्ये जोडेल."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambil foto atau pilih satu daripada pustaka anda. NeverNote akan membaca sebarang teks dalam imej dan menambahkannya pada nota anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta et bilde eller velg et fra biblioteket ditt. NeverNote vil lese all tekst i bildet og legge den til i notatet ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een foto of kies er een uit je bibliotheek. NeverNote leest elke tekst in de afbeelding en voegt deze toe aan uw notitie."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ ଫଟୋ ନିଅନ୍ତୁ କିମ୍ବା ଆପଣଙ୍କ ଲାଇବ୍ରେରୀରୁ ଗୋଟିଏ ବାଛନ୍ତୁ | କଦାପି ନୋଟ୍ ପ୍ରତିଛବିରେ କ text ଣସି ପାଠ ପ read ିବ ନାହିଁ ଏବଂ ଏହାକୁ ତୁମ ନୋଟରେ ଯୋଗ କରିବ |"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੱਕ ਫੋਟੋ ਲਓ ਜਾਂ ਆਪਣੀ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚੋਂ ਇੱਕ ਚੁਣੋ। NeverNote ਚਿੱਤਰ ਵਿੱਚ ਕਿਸੇ ਵੀ ਟੈਕਸਟ ਨੂੰ ਪੜ੍ਹੇਗਾ ਅਤੇ ਇਸਨੂੰ ਤੁਹਾਡੇ ਨੋਟ ਵਿੱਚ ਸ਼ਾਮਲ ਕਰੇਗਾ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrób zdjęcie lub wybierz jedno ze swojej biblioteki. NeverNote odczyta dowolny tekst z obrazu i doda go do Twojej notatki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire uma foto ou escolha uma da sua biblioteca. NeverNote irá ler qualquer texto da imagem e adicioná-lo à sua nota."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire uma foto ou escolha uma da sua biblioteca. NeverNote irá ler qualquer texto da imagem e adicioná-lo à sua nota."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți o fotografie sau alegeți una din biblioteca dvs. NeverNote va citi orice text din imagine și îl va adăuga la nota dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте фотографию или выберите одну из своей библиотеки. NeverNote прочитает любой текст на изображении и добавит его в заметку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odfoťte sa alebo si vyberte fotku zo svojej knižnice. NeverNote prečíta akýkoľvek text na obrázku a pridá ho do vašej poznámky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posnemite fotografijo ali izberite eno iz svoje knjižnice. NeverNote bo prebral katero koli besedilo na sliki in ga dodal vaši opombi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta ett foto eller välj ett från ditt bibliotek. NeverNote kommer att läsa all text i bilden och lägga till den i din anteckning."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படம் எடுக்கவும் அல்லது உங்கள் நூலகத்திலிருந்து ஒன்றைத் தேர்ந்தெடுக்கவும். NeverNote படத்தில் உள்ள எந்த உரையையும் படித்து அதை உங்கள் குறிப்பில் சேர்க்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోటో తీయండి లేదా మీ లైబ్రరీ నుండి ఒకదాన్ని ఎంచుకోండి. NeverNote చిత్రంలో ఏదైనా వచనాన్ని చదివి మీ గమనికకు జోడిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ่ายภาพหรือเลือกจากห้องสมุดของคุณ NeverNote จะอ่านข้อความใดๆ ในภาพและเพิ่มลงในบันทึกย่อของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir fotoğraf çekin veya kitaplığınızdan bir fotoğraf seçin. NeverNote, görseldeki herhangi bir metni okuyacak ve notunuza ekleyecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зробіть фотографію або виберіть фотографію зі своєї бібліотеки. NeverNote прочитає будь-який текст на зображенні та додасть його до вашої нотатки."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک تصویر لیں یا اپنی لائبریری سے ایک کا انتخاب کریں۔ NeverNote تصویر میں کسی بھی متن کو پڑھے گا اور اسے آپ کے نوٹ میں شامل کرے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp ảnh hoặc chọn một bức ảnh từ thư viện của bạn. NeverNote sẽ đọc bất kỳ văn bản nào trong hình ảnh và thêm nó vào ghi chú của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍一张照片或从图库中选择一张。 NeverNote 将读取图像中的任何文本并将其添加到您的笔记中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拍一張照片或從圖庫中選擇一張。 NeverNote 將讀取圖像中的任何文字並將其添加到您的筆記中。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "拍一張照片或從圖庫中選擇一張。 NeverNote 將讀取圖像中的任何文字並將其添加到您的筆記中。"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem 'n foto of kies een uit jou biblioteek. NeverNote sal enige teks in die beeld lees en dit by jou nota voeg."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Направете снимка или изберете такава от вашата библиотека. NeverNote ще прочете всеки текст в изображението и ще го добави към бележката ви."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehke foto või valige üks oma teegist. NeverNote loeb pildi kõik tekstid ja lisab need teie märkusesse."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Atera argazki bat edo aukeratu bat zure liburutegitik. NeverNote-k irudiko edozein testu irakurriko du eta zure oharrari gehituko dio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عکس بگیرید یا یکی را از کتابخانه‌تان انتخاب کنید. NeverNote هر متنی در تصویر را می‌خواند و به یادداشت شما اضافه می‌کند."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tóg grianghraf nó roghnaigh ceann ó do leabharlann. Léifidh NeverNote aon téacs san íomhá agus cuirfidh sé le do nóta é."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai unha foto ou escolle unha da túa biblioteca. NeverNote lerá calquera texto da imaxe e engadirao á túa nota."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Lusankaretsek kam entrek mek dzer gradarnits. NeverNote-y kardа patkerу amen tekste yev kaveyi dzer nshman."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Taktu mynd eða veldu eina úr bókasafni þínu. NeverNote les allan texta í myndinni og bætir honum við athugasemdina þína."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გადაიღეთ ფოტო ან აირჩიეთ ბიბლიოთეკიდან. NeverNote წაიკითხავს გამოსახულებაში ნებისმიერ ტექსტს და დაამატებს თქვენს ჩანაწერს."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nufotografuokite arba pasirinkite iš savo bibliotekos. NeverNote perskaitys bet kokį vaizdų tekstą ir pridės jį prie jūsų pastabos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzņemiet foto vai izvēlieties to no savas bibliotēkas. NeverNote nolasīs jebkuru tekstu attēlā un pievienos to jūsu piezīmei."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Направете фото или изберете едно од вашата библиотека. NeverNote ќе прочита какав било текст во сликата и ќе го додаде во вашата белешка."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Bëni një foto ose zgjidhni një nga biblioteka juaj. NeverNote do të lexojë çdo tekst në imazh dhe do ta shtojë në shënimin tuaj."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Направите фотографију или изаберите из библиотеке. NeverNote ће прочитати сваки текст на слици и додати га у белешку."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Piga picha au chagua moja kutoka kwenye maktaba yako. NeverNote itasoma maandishi yoyote kwenye picha na kuiongeza kwenye kidokezo chako."
          }
        }
      }
    },
