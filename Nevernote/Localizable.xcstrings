    "Open Nevernote to read or capture a note.": {
      "comment": "Open Nevernote to read or capture a note.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Nevernote to read or capture a note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Nevernote para leer o capturar una nota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Nevernote pour lire ou capturer une note."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Nevernote, um eine Notiz zu lesen oder zu erfassen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Nevernote per leggere o acquisire una nota."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Nevernote para ler ou capturar uma nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevernote を開いてメモを読んだりキャプチャしたりします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nevernote를 열어 메모를 읽거나 캡처하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Nevernote 来阅读或捕获笔记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 Nevernote 來閱讀或捕捉筆記。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Nevernote لقراءة ملاحظة أو التقاطها."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Nevernote, чтобы прочитать или сохранить заметку."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी नोट को पढ़ने या कैप्चर करने के लिए नेवरनोट खोलें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Nevernote om een ​​notitie te lezen of vast te leggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Nevernote, aby przeczytać lub przechwycić notatkę."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Nevernote för att läsa eller fånga en anteckning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir notu okumak veya yakalamak için Nevernote'u açın."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Nevernote เพื่ออ่านหรือบันทึกบันทึก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Nevernote để đọc hoặc ghi chú."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Nevernote untuk membaca atau mengambil catatan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Nevernote, щоб прочитати або записати нотатку."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח את Nevernote כדי לקרוא או ללכוד הערה."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি নোট পড়তে বা ক্যাপচার করতে Nevernote খুলুন।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு குறிப்பைப் படிக்க அல்லது பிடிக்க Nevernote ஐத் திறக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గమనికను చదవడానికి లేదా క్యాప్చర్ చేయడానికి Nevernoteని తెరవండి."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट वाचण्यासाठी किंवा कॅप्चर करण्यासाठी Nevernote उघडा."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نوٹ پڑھنے یا کیپچر کرنے کے لیے Nevernote کھولیں۔"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Nevernote for at læse eller fange en note."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Nevernote for å lese eller fange et notat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Nevernote lukeaksesi tai tallentaaksesi muistiinpanon."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete Nevernote a přečtěte si nebo zaznamenejte poznámku."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak si chcete prečítať alebo zachytiť poznámku, otvorte Nevernote."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jegyzet olvasásához vagy rögzítéséhez nyissa meg a Nevernote alkalmazást."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschideți Nevernote pentru a citi sau a captura o notă."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite Nevernote da biste pročitali ili snimili bilješku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odprite Nevernote, da preberete ali zajamete zapisek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε το Nevernote για να διαβάσετε ή να καταγράψετε μια σημείωση."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obriu Nevernote per llegir o capturar una nota."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Nevernote untuk membaca atau menangkap nota."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Nevernote para ler ou capturar uma nota."
          }
        }
      }
