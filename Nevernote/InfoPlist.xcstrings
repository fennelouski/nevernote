{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "Privacy - NSCameraUsageDescription",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote uses the camera to photograph text and import it into your note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote usa la cámara para fotografiar texto e importarlo a su nota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote utilise l'appareil photo pour photographier le texte et l'importer dans votre note."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote verwendet die Kamera, um Text zu fotografieren und in Ihre Notiz zu importieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote utilizza la fotocamera per fotografare il testo e importarlo nella nota."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote usa a câmera para fotografar texto e importá-lo para sua nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote はカメラを使用してテキストを撮影し、ノートにインポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote는 카메라를 사용하여 텍스트를 촬영하고 이를 노트로 가져옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote 使用相机拍摄文本并将其导入到您的笔记中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote 使用相機拍攝文字並將其匯入到您的筆記中。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم NeverNote الكاميرا لتصوير النص واستيراده إلى ملاحظتك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote использует камеру для фотографирования текста и импорта его в заметку."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेवरनोट टेक्स्ट का फोटो खींचने और उसे आपके नोट में आयात करने के लिए कैमरे का उपयोग करता है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote gebruikt de camera om tekst te fotograferen en deze in uw notitie te importeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote używa aparatu do fotografowania tekstu i importowania go do notatki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote använder kameran för att fotografera text och importera den till din anteckning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote, metni fotoğraflamak ve notunuza aktarmak için kamerayı kullanır."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote ใช้กล้องเพื่อถ่ายภาพข้อความและนำเข้าลงในบันทึกย่อของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote sử dụng máy ảnh để chụp ảnh văn bản và nhập nó vào ghi chú của bạn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote menggunakan kamera untuk memotret teks dan mengimpornya ke catatan Anda."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - NSPhotoLibraryUsageDescription",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote accesses your photo library to import text from a photo into your note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote accede a su biblioteca de fotos para importar texto de una foto a su nota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote accède à votre photothèque pour importer le texte d'une photo dans votre note."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote greift auf Ihre Fotobibliothek zu, um Text aus einem Foto in Ihre Notiz zu importieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote accede alla tua libreria di foto per importare il testo da una foto nella tua nota."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote acessa sua biblioteca de fotos para importar texto de uma foto para sua nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote は写真ライブラリにアクセスして、写真からテキストをノートにインポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote는 사진 라이브러리에 액세스하여 사진의 텍스트를 노트로 가져옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote 访问您的照片库，将照片中的文本导入到您的笔记中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote 存取您的照片庫，將照片中的文字匯入到您的筆記中。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصل NeverNote إلى مكتبة الصور الخاصة بك لاستيراد نص من صورة إلى ملاحظتك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote обращается к вашей библиотеке фотографий, чтобы импортировать текст с фотографии в заметку."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेवरनोट किसी फोटो से टेक्स्ट को आपके नोट में आयात करने के लिए आपकी फोटो लाइब्रेरी तक पहुंचता है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote heeft toegang tot uw fotobibliotheek om tekst van een foto in uw notitie te importeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote uzyskuje dostęp do Twojej biblioteki zdjęć i importuje tekst ze zdjęcia do notatki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote kommer åt ditt fotobibliotek för att importera text från ett foto till din anteckning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote, bir fotoğraftaki metni notunuza aktarmak için fotoğraf kitaplığınıza erişir."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote เข้าถึงไลบรารีรูปภาพของคุณเพื่อนำเข้าข้อความจากรูปภาพไปยังบันทึกย่อของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote truy cập thư viện ảnh của bạn để nhập văn bản từ ảnh vào ghi chú của bạn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote mengakses perpustakaan foto Anda untuk mengimpor teks dari foto ke catatan Anda."
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "comment": "Bundle display name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "NeverNote"
          }
        }
      }
    },
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
