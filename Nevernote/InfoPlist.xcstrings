{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "Privacy - NSCameraUsageDescription",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote uses the camera to photograph text and import it into your note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote usa la cámara para fotografiar texto e importarlo en tu nota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote utilise l'appareil photo pour photographier le texte et l'importer dans votre note."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote verwendet die Kamera, um Text zu fotografieren und in Ihre Notiz zu importieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote utilizza la fotocamera per fotografare il testo e importarlo nella nota."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote usa a câmera para fotografar texto e importá-lo para sua nota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote はカメラを使用してテキストを撮影し、ノートにインポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote는 카메라를 사용하여 텍스트를 촬영하고 이를 노트로 가져옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote 使用相机拍摄文本并将其导入到您的笔记中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote 使用相機拍攝文字並將其匯入到您的筆記中。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم NeverNote الكاميرا لتصوير النص واستيراده إلى ملاحظتك."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote использует камеру для фотографирования текста и импорта его в заметку."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote टेक्स्ट का फोटो खींचने और उसे आपके नोट में आयात करने के लिए कैमरे का उपयोग करता है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote gebruikt de camera om tekst te fotograferen en deze in uw notitie te importeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote używa aparatu do fotografowania tekstu i importowania go do notatki."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote använder kameran för att fotografera text och importera den till din anteckning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote, metni fotoğraflamak ve notunuza aktarmak için kamerayı kullanır."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote ใช้กล้องเพื่อถ่ายภาพข้อความและนำเข้าลงในบันทึกย่อของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote sử dụng máy ảnh để chụp ảnh văn bản và nhập nó vào ghi chú của bạn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote menggunakan kamera untuk memotret teks dan mengimpornya ke catatan Anda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote використовує камеру, щоб сфотографувати текст і імпортувати його у вашу нотатку."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote משתמש במצלמה כדי לצלם טקסט ולייבא אותו לפתק שלך."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote টেক্সট ফটোগ্রাফ করতে এবং আপনার নোটে আমদানি করতে ক্যামেরা ব্যবহার করে।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote உரையை புகைப்படம் எடுத்து உங்கள் குறிப்பில் இறக்குமதி செய்ய கேமராவைப் பயன்படுத்துகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote టెక్స్ట్‌ని ఫోటోగ్రాఫ్ చేయడానికి మరియు మీ నోట్‌లోకి దిగుమతి చేసుకోవడానికి కెమెరాను ఉపయోగిస్తుంది."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote कॅमेऱ्याचा वापर मजकूर फोटो काढण्यासाठी आणि तुमच्या नोटमध्ये आयात करण्यासाठी करते."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote متن کی تصویر کشی کرنے اور اسے آپ کے نوٹ میں درآمد کرنے کے لیے کیمرے کا استعمال کرتا ہے۔"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote bruger kameraet til at fotografere tekst og importere den til din note."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote bruker kameraet til å fotografere tekst og importere den til notatet ditt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote käyttää kameraa tekstin kuvaamiseen ja tuomiseen muistiinpanoosi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote používá fotoaparát k fotografování textu a jeho importu do vaší poznámky."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote používa fotoaparát na fotografovanie textu a jeho importovanie do vašej poznámky."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A NeverNote a kamerával lefényképezi a szöveget, és importálja azt a jegyzetébe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote folosește camera pentru a fotografia text și pentru a-l importa în notă."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote koristi kameru za fotografiranje teksta i uvoz u vašu bilješku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote s kamero fotografira besedilo in ga uvozi v vašo beležko."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το NeverNote χρησιμοποιεί την κάμερα για να φωτογραφίζει κείμενο και να το εισάγει στη σημείωσή σας."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote utilitza la càmera per fotografiar text i importar-lo a la teva nota."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote menggunakan kamera untuk mengambil gambar teks dan mengimportnya ke dalam nota anda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O NeverNote utiliza a câmara para fotografar texto e importá-lo para a sua nota."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote използва камерата, за да снима текст и да го импортира във вашата бележка."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote kasutab kaamerat teksti pildistamiseks ja selle märkmesse importimiseks."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote izmanto kameru, lai fotografētu tekstu un importētu to savā piezīmē."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote naudoja fotoaparatą tekstui nufotografuoti ir importuoti jį į užrašą."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote користи камеру да фотографише текст и увезе га у белешку."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote gebruik die kamera om teks te fotografeer en dit in jou nota in te voer."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote notar myndavélina til að mynda texta og flytja hann inn í minnismiða þína."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote ја користи камерата за да фотографира текст и да го внесува во вашата белешка."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Úsáideann NeverNote an ceamara chun téacs a ghrianghrafadh agus é a allmhairiú isteach i do nóta."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote камераны мәтінді суретке түсіру және оны жазбаңызға импорттау үшін пайдаланады."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote mətnin şəklini çəkmək və onu qeydinizə idxal etmək üçün kameradan istifadə edir."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote-k kamera erabiltzen du testua argazkiak ateratzeko eta oharrean inportatzeko."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote usa a cámara para fotografar texto e importalo na túa nota."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote hutumia kamera kupiga picha maandishi na kuyaingiza kwenye dokezo lako."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "I-NeverNote isebenzisa ikhamera ukuze ithwebule umbhalo futhi iwungenise kunothi lakho."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote ጽሑፍን ፎቶግራፍ ለማንሳት እና ወደ ማስታወሻዎ ለማስመጣት ካሜራውን ይጠቀማል።"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote ប្រើកាមេរ៉ាដើម្បីថតរូបអត្ថបទ និងនាំចូលវាទៅក្នុងចំណាំរបស់អ្នក។"
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote ໃຊ້ກ້ອງຖ່າຍຮູບເພື່ອຖ່າຍຮູບຂໍ້ຄວາມແລະນໍາເຂົ້າມັນເຂົ້າໄປໃນບັນທຶກຂອງທ່ານ."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote သည် စာသားကို ဓာတ်ပုံရိုက်ပြီး သင့်မှတ်စုထဲသို့ ထည့်သွင်းရန် ကင်မရာကို အသုံးပြုသည်။"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "NeverNote ले पाठ फोटो खिच्न र तपाईंको नोटमा आयात गर्न क्यामेरा प्रयोग गर्दछ।"
          }
        },
